# Token the Kindle plugin sends as "Authorization: Bearer" (typed in the plugin menu). Generate: openssl rand -hex 32
PLUGIN_TOKEN=
PORT=3333
TZ_NAME=America/Fortaleza
# Defaults to ./data when running outside Docker
# DATA_PATH=
# Server LAN IP the container port is published on (compose.yaml)
LAN_IP=192.168.0.10
