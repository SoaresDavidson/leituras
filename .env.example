# Token the Kindle plugin sends as "Authorization: Bearer". Generate: openssl rand -hex 32
PLUGIN_TOKEN=
# URL the Kindle uses to reach the server (baked into the plugin by `npm run build-plugin`)
PUBLIC_URL=http://192.168.0.10:3333
PORT=3333
TZ_NAME=America/Fortaleza
# Defaults to ./data when running outside Docker
# DATA_PATH=
