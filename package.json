{
  "name": "leituras",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=web",
    "build": "npm run build --workspace=web && npm run build --workspace=server",
    "test": "npm test --workspace=server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "set-password": "npm run set-password --workspace=server --",
    "build-plugin": "npm run build-plugin --workspace=server"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
